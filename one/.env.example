DB_HOST=database
DB_PORT=5432
DB_PASSWORD=password
DB_USER=postgres
DB_NAME=one

# DATABASE_URL must be kept in sync with the DB_* variables above.
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# The host (<DB_HOST>) must match the Docker Compose service name of the
# Postgres container (e.g. "database"), NOT "localhost" — containers talk
# to each other via service names on the shared Docker network.
# When running Prisma from the HOST machine instead of inside a container,
# replace the host with "localhost" (requires the DB port to be published).
DATABASE_URL=postgresql://postgres:password@database:5432/one

NEXT_PUBLIC_API_URL=/nest